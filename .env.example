# AgentOS environment — SERVER-ONLY. Never place secrets in the frontend.
# Copy to .env and adjust. Validated at boot by @agentos/config (fail-fast).

NODE_ENV=development
LOG_LEVEL=info
API_PORT=4000

# Infrastructure (brought up by: docker compose -f infra/compose.yaml up -d):
# DATABASE_URL=postgresql://agentos:agentos@localhost:5432/agentos?schema=public
# REDIS_URL=redis://localhost:6380   # required by the DURABLE PROFILE below (queue + automations)

# Secrets (encrypted at rest, server-side only). MASTER_ENCRYPTION_KEY is base64, 32 bytes; keep it
# stable so stored brain keys / connector tokens decrypt across restarts.
# ANTHROPIC_API_KEY=
# MASTER_ENCRYPTION_KEY=

# ── SAFE DURABLE PROFILE ────────────────────────────────────────────────────────────────────────
# The recommended local/production posture: durable execution + the activated flagship subsystems.
# Run `scripts/doctor.ps1` to verify each is on (it WARNs for any durability gap). All flags fail-closed
# (default off), so omitting a line falls back to the non-durable behaviour.
# LLM_MODE=live                      # 'mock' for CI/e2e (no key, scripted provider)
# EXECUTION_MODE=queue               # tasks run via the in-process BullMQ worker -> crash/restart recovers
#                                    # in-flight work + scheduled automations fire (needs REDIS_URL)
# RESUME_ENABLED=true                # write step snapshots + re-claim orphaned tasks after a crash
# FOLLOWUP_TURNS_ENABLED=true        # a finished task accepts a reply + continues the same task
# ARTIFACT_PERSISTENCE_ENABLED=true  # deliverables stored as versioned blobs (history + rollback)
# ARTIFACT_STORE_ROOT=/var/agentos-artifacts   # MUST be OUTSIDE AGENT_SANDBOX_ROOT (survives sandbox wipe)
# AUTOMATION_RUNS_ENABLED=true       # each cron fire records a durable AutomationRun (overlap-skip + retry)
# ALLOW_LOCAL_BRAIN_URL=true         # allow a private/loopback brain baseUrl (self-hosted vLLM/MiMo)
