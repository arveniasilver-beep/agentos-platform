{
  "name": "@agentos/agent-engine",
  "version": "0.0.0",
  "private": true,
  "description": "The agent runtime: plan -> act -> observe -> verify loop, state machine, budgets, instant stop.",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@agentos/llm": "workspace:*",
    "@agentos/protocol": "workspace:*"
  }
}
