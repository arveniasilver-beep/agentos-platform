{
  "name": "@agentos/tool-abi",
  "version": "0.0.0",
  "private": true,
  "description": "Typed, risk-tagged tool definitions: one Zod source -> LLM JSON Schema + runtime validation.",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@agentos/protocol": "workspace:*",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  }
}
