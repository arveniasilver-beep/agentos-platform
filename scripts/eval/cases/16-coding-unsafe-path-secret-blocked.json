{
  "id": "coding-unsafe-path-secret-blocked",
  "category": "security",
  "description": "Coding workspace: a workspace-escaping path is denied and a secret (.env) edit needs elevated approval; neither writes.",
  "env": { "CODING_WORKSPACE_ENABLED": "true", "POLICY_ENGINE_ENABLED": "true", "POLICY_GRANTED_SCOPES": "fs.write,fs.read" },
  "toolset": "coding",
  "approvals": { "autoDecision": "deny" },
  "task": { "prompt": "Try to edit outside the workspace and the .env file." },
  "script": [
    { "text": "attempting", "stopReason": "end_turn" },
    { "toolCalls": [{ "name": "write_file", "input": { "path": "../escape.ts", "content": "x" } }], "stopReason": "tool_use" },
    { "toolCalls": [{ "name": "write_file", "input": { "path": ".env", "content": "SECRET=leak" } }], "stopReason": "tool_use" },
    { "text": "blocked", "stopReason": "end_turn" }
  ],
  "expect": {
    "status": "completed",
    "toolRan": { "write_file": false },
    "policy": [
      { "tool": "write_file", "effect": "deny" },
      { "tool": "write_file", "effect": "require_elevated_approval" }
    ],
    "noSecretLeak": ["SECRET=leak"]
  }
}
