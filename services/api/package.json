{
  "name": "@agentos/api",
  "version": "0.0.0",
  "private": true,
  "description": "AgentOS backend API (NestJS on Fastify).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node test/auth.e2e.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@agentos/agent-engine": "workspace:*",
    "@agentos/auth": "workspace:*",
    "@agentos/brand": "workspace:*",
    "@agentos/config": "workspace:*",
    "@agentos/crypto": "workspace:*",
    "@agentos/db": "workspace:*",
    "@agentos/llm": "workspace:*",
    "@agentos/protocol": "workspace:*",
    "@agentos/tools": "workspace:*",
    "@fastify/cookie": "^9.4.0",
    "@fastify/helmet": "^11.1.1",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/throttler": "^6.3.0",
    "@nestjs/websockets": "^10.4.15",
    "bullmq": "^5.34.0",
    "ioredis": "5.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
